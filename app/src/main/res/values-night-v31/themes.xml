        <item name="android:colorPrimary">@android:color/system_accent1_200</item>
        <item name="android:colorPrimaryDark">@android:color/system_neutral1_900</item>
        <item name="android:statusBarColor">@android:color/system_neutral1_900</item>
        <item name="android:navigationBarColor">@android:color/system_neutral1_900</item>
        <item name="android:windowBackground">@android:color/system_neutral1_1000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
