        <item name="android:colorPrimaryDark">@android:color/system_neutral1_100</item>
        <item name="android:statusBarColor">@android:color/system_neutral1_100</item>
        <item name="android:navigationBarColor">@android:color/system_neutral1_100</item>
        <item name="android:windowBackground">@android:color/system_neutral1_10</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
